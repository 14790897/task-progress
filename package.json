{
  "name": "task-progress",
  "version": "1.0.0",
  "description": "Show a per-note task progress ring in Obsidian's file explorer.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
